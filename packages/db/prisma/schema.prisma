// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  githubId    Int      @unique
  login       String
  avatarUrl   String?
  createdAt   DateTime   @default(now())
  sessions    Session[]
  runs        Run[]
  threads     Thread[]
  budget      Budget?
}

// A conversation with one agent about one repo. Each message is a Run (a
// turn). Turns share a git branch and one pull request, and resume the
// agent's own session through agentSessionId.
model Thread {
  id             String   @id @default(uuid())
  userId         String
  repo           String
  baseBranch     String
  harness        String
  title          String
  branch         String
  agentSessionId String?
  prUrl          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs           Run[]
  @@index([userId, updatedAt])
}

// Instance configuration entered in the browser (model keys, the GitHub App's
// credentials, the sign-in allowlist). `value` is AES-256-GCM ciphertext; a
// value here wins over the same name in .env.
model Setting {
  name      String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Monthly model-spend limit. warnedMonth/stoppedMonth hold "YYYY-MM" so each
// threshold notifies once per calendar month (UTC), not on every run.
model Budget {
  userId          String   @id
  monthlyLimitUsd Decimal  @default(10)
  alertEmail      String?
  warnedMonth     String?
  stoppedMonth    String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Run {
  id         String   @id @default(uuid())
  userId     String?
  status     RunStatusEnum
  createdAt  DateTime @default(now())
  leaseUntil DateTime?
  leaseGen   Int      @default(0)
  attempts   Int      @default(0)
  cancelRequested Boolean @default(false)
  costUsd    Decimal?   @default(0)
  repo       String
  baseBranch String
  branch     String?
  prompt     String
  harness    String
  workerId   String?
  sessionId  String?
  baseSha    String?
  commitSha  String?
  patchHash  String?
  prUrl      String?
  error      String?
  threadId   String?
  events     RunEvent[]
  user       User?    @relation(fields: [userId],references: [id],onDelete: Cascade)
  thread     Thread?  @relation(fields: [threadId],references: [id],onDelete: Cascade)
  @@index([status,createdAt])
  @@index([userId])
  @@index([threadId, createdAt])
}

model RunEvent {
  runId     String  
  seq       Int
  ts        DateTime @default(now())
  kind      RunEventEnum
  data      Json?
  run       Run   @relation(fields:[runId], references: [id],onDelete: Cascade)
  @@id([runId, seq])
  
}

enum RunStatusEnum{
  queued
  running
  finalizing
  succeeded
  failed
  cancelled
}

enum RunEventEnum{
  status
  text
  tool_call
  tool_result
  raw
  error
  done
}
/// The sandbox image built from the user's setup script (one row, id 1).
model SandboxImage {
  id         Int      @id @default(1)
  /// Hash of the base image and script the latest build was for.
  scriptHash String   @default("")
  /// pending | building | ready | failed
  status     String   @default("ready")
  log        String   @default("")
  /// The last image that built successfully; runs use it.
  image      String   @default("cloud-agents-base")
  updatedAt  DateTime @updatedAt
}
