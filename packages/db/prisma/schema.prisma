// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  githubId    Int      @unique
  login       String
  avatarUrl   String?
  createdAt   DateTime   @default(now())
  sessions    Session[]
  runs        Run[]
  threads     Thread[]
  arenas      Arena[]
  previews    Preview[]
  tokens      AccessToken[]
  budget      Budget?
}

// A conversation with one agent about one repo. Each message is a Run (a
// turn). Turns share a git branch and one pull request, and resume the
// agent's own session through agentSessionId.
model Thread {
  id             String   @id @default(uuid())
  userId         String
  repo           String
  baseBranch     String
  harness        String
  title          String
  branch         String
  agentSessionId String?
  /// Chosen with "/model <name>" in the chat; passed to every later turn, so it
  /// beats a model pinned in the repo's own agent settings.
  model          String?
  /// How hard the agent thinks (see @repo/shared/effort); null is its default.
  effort         String?
  prUrl          String?
  /// Set when the session is one of an arena's agents (see Arena).
  arenaId        String?
  /// Open a pull request when a turn changes code. Arena sessions wait until
  /// their result is picked.
  autoPr         Boolean  @default(true)
  /// Turns get a virtual display the agent can use and the user can watch.
  desktop        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  arena          Arena?   @relation(fields: [arenaId], references: [id], onDelete: SetNull)
  runs           Run[]
  previews       Preview[]
  @@index([userId, updatedAt])
  @@index([arenaId])
}

/// One task handed to several agents at once, each in its own session and
/// branch, so their results can be compared before one becomes the PR.
model Arena {
  id             String   @id @default(uuid())
  userId         String
  repo           String
  baseBranch     String
  prompt         String
  /// The session whose branch was opened as the pull request.
  winnerThreadId String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads        Thread[]
  @@index([userId, createdAt])
}

/// A remote MCP server the agents may use. Its credentials (OAuth tokens and
/// client, or a bearer token) are AES-256-GCM ciphertext in `secret`, and only
/// ever reach the credential gateway, never a sandbox.
model McpServer {
  id        String   @id @default(uuid())
  /// What agents see it as: lowercase letters, digits and dashes.
  name      String   @unique
  url       String
  /// oauth | bearer | none
  auth      String   @default("oauth")
  enabled   Boolean  @default(true)
  /// connected | needs_auth | error
  status    String   @default("needs_auth")
  error     String?
  secret    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An environment variable for runs. The sandbox gets a placeholder, and the
/// gateway swaps in the real value only on HTTPS requests to `hosts`, unless
/// `exposed` puts the real value in the sandbox.
model EnvSecret {
  id        String   @id @default(uuid())
  name      String
  /// "owner/repo", or "*" for every repo.
  repo      String   @default("*")
  /// Ciphertext.
  value     String
  /// Newline-separated; subdomains are included.
  hosts     String   @default("")
  exposed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([repo, name])
}

/// A repo's files outside git, mounted at /files in every run. Whatever the
/// agent leaves there is saved back for the next run.
model RepoFile {
  repo      String
  path      String
  content   Bytes
  size      Int
  sha256    String
  updatedAt DateTime @updatedAt
  @@id([repo, path])
}

/// A session's app, started from its branch and kept running so the user can
/// open it, or watch it on the sandbox's desktop.
model Preview {
  id          String   @id @default(uuid())
  threadId    String
  userId      String
  /// requested | starting | running | stopping | stopped | failed
  status      String   @default("requested")
  command     String
  port        Int
  desktop     Boolean  @default(false)
  workerId    String?
  error       String?
  log         String   @default("")
  vncPassword String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([threadId, createdAt])
}

// Instance configuration entered in the browser (model keys, the GitHub App's
// credentials, the sign-in allowlist). `value` is AES-256-GCM ciphertext; a
// value here wins over the same name in .env.
model Setting {
  name      String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Monthly model-spend limit. warnedMonth/stoppedMonth hold "YYYY-MM" so each
// threshold notifies once per calendar month (UTC), not on every run.
model Budget {
  userId          String   @id
  monthlyLimitUsd Decimal  @default(10)
  alertEmail      String?
  warnedMonth     String?
  stoppedMonth    String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Run {
  id         String   @id @default(uuid())
  userId     String?
  status     RunStatusEnum
  createdAt  DateTime @default(now())
  leaseUntil DateTime?
  leaseGen   Int      @default(0)
  attempts   Int      @default(0)
  cancelRequested Boolean @default(false)
  costUsd    Decimal?   @default(0)
  /// Ran on the user's Claude or ChatGPT plan: no per-run cost, not counted toward the spend limit.
  onPlan     Boolean    @default(false)
  repo       String
  baseBranch String
  branch     String?
  prompt     String
  harness    String
  workerId   String?
  sessionId  String?
  baseSha    String?
  commitSha  String?
  patchHash  String?
  prUrl      String?
  error      String?
  threadId   String?
  /// From the turn's patch, for comparing agents.
  filesChanged Int?
  additions  Int?
  deletions  Int?
  /// The turn's virtual display (VNC) password, when the session has a desktop.
  desktopPassword String?
  events     RunEvent[]
  user       User?    @relation(fields: [userId],references: [id],onDelete: Cascade)
  thread     Thread?  @relation(fields: [threadId],references: [id],onDelete: Cascade)
  @@index([status,createdAt])
  @@index([userId])
  @@index([threadId, createdAt])
}

model RunEvent {
  runId     String  
  seq       Int
  ts        DateTime @default(now())
  kind      RunEventEnum
  data      Json?
  run       Run   @relation(fields:[runId], references: [id],onDelete: Cascade)
  @@id([runId, seq])
  
}

enum RunStatusEnum{
  queued
  running
  finalizing
  succeeded
  failed
  cancelled
}

enum RunEventEnum{
  status
  text
  tool_call
  tool_result
  raw
  error
  done
}
/// The sandbox image built from the user's setup script (one row, id 1).
model SandboxImage {
  id         Int      @id @default(1)
  /// Hash of the base image and script the latest build was for.
  scriptHash String   @default("")
  /// pending | building | ready | failed
  status     String   @default("ready")
  log        String   @default("")
  /// The last image that built successfully; runs use it.
  image      String   @default("cloud-agents-base")
  updatedAt  DateTime @updatedAt
}

/// Shared context for a repo, opt-in: notes every agent reads, plus a log of
/// what each session and connected editor did, so Claude, Codex, Gemini and
/// local tools (Cursor, Claude Code, through the context MCP endpoint) work from
/// the same picture of the repo.
model RepoContext {
  repo      String   @id
  enabled   Boolean  @default(true)
  /// Conventions and decisions, in Markdown. Editable by the user and agents.
  notes     String   @default("")
  updatedAt DateTime @updatedAt
}

model ContextEntry {
  id        String   @id @default(uuid())
  repo      String
  /// turn | note | decision
  kind      String
  /// The agent (its harness id) or the connected tool's name, e.g. "Cursor on my laptop".
  author    String
  /// cloudly | mcp
  source    String
  title     String
  body      String   @default("")
  threadId  String?
  runId     String?
  prUrl     String?
  createdAt DateTime @default(now())
  @@index([repo, createdAt])
}

/// A personal token for tools outside Cloudly (Cursor, Claude Code) to reach
/// the context MCP endpoint. Only its SHA-256 is stored.
model AccessToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
