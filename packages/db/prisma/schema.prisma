// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  githubId    Int      @unique
  login       String
  avatarUrl   String?
  createdAt   DateTime   @default(now())
  sessions    Session[]
  runs        Run[]
  threads     Thread[]
  arenas      Arena[]
  previews    Preview[]
  tokens      AccessToken[]
  councils    Council[]
  budget      Budget?
}

// A conversation with one agent about one repo. Each message is a Run (a
// turn). Turns share a git branch and one pull request, and resume the
// agent's own session through agentSessionId.
model Thread {
  id             String   @id @default(uuid())
  userId         String
  repo           String
  baseBranch     String
  harness        String
  title          String
  branch         String
  agentSessionId String?
  /// Chosen with "/model <name>" in the chat; passed to every later turn, so it
  /// beats a model pinned in the repo's own agent settings.
  model          String?
  /// How hard the agent thinks (see @repo/shared/effort); null is its default.
  effort         String?
  prUrl          String?
  /// Set when the session is one of an arena's agents (see Arena).
  arenaId        String?
  /// Open a pull request when a turn changes code. Arena sessions wait until
  /// their result is picked.
  autoPr         Boolean  @default(true)
  /// Turns get a virtual display the agent can use and the user can watch.
  desktop        Boolean  @default(false)
  /// Which other sessions its agent may read and message (see @repo/shared/sessions):
  /// "repo" (this repo's), "all" (every one of the user's), or "off".
  peers          String   @default("repo")
  /// Sidebar state, like T3 Code's threads. Pinned sessions sit at the top.
  pinnedAt       DateTime?
  /// Done for now: folded into the sidebar's Settled section until there's new activity.
  settledAt      DateTime?
  /// Hidden from the sidebar until this time, then back as unread.
  snoozedUntil   DateTime?
  /// Out of the sidebar and out of other sessions' reach, until unarchived.
  archivedAt     DateTime?
  /// When the user last looked at it; a turn that ended after this is unread. Null is never.
  seenAt         DateTime?
  /// The question the agent asked with ask_user, until the user answers.
  needsInput     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  arena          Arena?   @relation(fields: [arenaId], references: [id], onDelete: SetNull)
  runs           Run[]
  previews       Preview[]
  @@index([userId, updatedAt])
  @@index([arenaId])
}

/// One task handed to several agents at once, each in its own session and
/// branch, so their results can be compared before one becomes the PR.
model Arena {
  id             String   @id @default(uuid())
  userId         String
  repo           String
  baseBranch     String
  prompt         String
  /// The session whose branch was opened as the pull request.
  winnerThreadId String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads        Thread[]
  @@index([userId, createdAt])
}

/// A remote MCP server the agents may use. Its credentials (OAuth tokens and
/// client, or a bearer token) are AES-256-GCM ciphertext in `secret`, and only
/// ever reach the credential gateway, never a sandbox.
model McpServer {
  id        String   @id @default(uuid())
  /// What agents see it as: lowercase letters, digits and dashes.
  name      String   @unique
  url       String
  /// oauth | bearer | none
  auth      String   @default("oauth")
  enabled   Boolean  @default(true)
  /// connected | needs_auth | error
  status    String   @default("needs_auth")
  error     String?
  secret    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An agent added under Settings > Agents, beyond the three built in: from
/// Cloudly's catalog, the ACP registry, or a command the user entered (see
/// @repo/shared/providers). The sandbox image installs it and turns run it over
/// the Agent Client Protocol. Its keys reach the sandbox only as placeholders.
model Provider {
  /// Its harness id: "acp-" and a slug.
  id        String   @id
  name      String
  /// catalog | registry | custom
  source    String
  /// The catalog or registry id it came from.
  sourceId  String?
  /// The registry version it was added at.
  version   String?
  icon      String?
  /// How the image installs it, how the runner starts it, its keys and hosts (ProviderSpec).
  spec      Json
  /// AES-256-GCM ciphertext of { ENV_NAME: value }.
  secret    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An environment variable for runs. The sandbox gets a placeholder, and the
/// gateway swaps in the real value only on HTTPS requests to `hosts`, unless
/// `exposed` puts the real value in the sandbox.
model EnvSecret {
  id        String   @id @default(uuid())
  name      String
  /// "owner/repo", or "*" for every repo.
  repo      String   @default("*")
  /// Ciphertext.
  value     String
  /// Newline-separated; subdomains are included.
  hosts     String   @default("")
  exposed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([repo, name])
}

/// A repo's files outside git, mounted at /files in every run. Whatever the
/// agent leaves there is saved back for the next run.
model RepoFile {
  repo      String
  path      String
  content   Bytes
  size      Int
  sha256    String
  updatedAt DateTime @updatedAt
  @@id([repo, path])
}

/// A session's app, started from its branch and kept running so the user can
/// open it, or watch it on the sandbox's desktop.
model Preview {
  id          String   @id @default(uuid())
  threadId    String
  userId      String
  /// requested | starting | running | stopping | stopped | failed
  status      String   @default("requested")
  command     String
  port        Int
  desktop     Boolean  @default(false)
  workerId    String?
  error       String?
  log         String   @default("")
  vncPassword String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([threadId, createdAt])
}

// Instance configuration entered in the browser (model keys, the GitHub App's
// credentials, the sign-in allowlist). `value` is AES-256-GCM ciphertext; a
// value here wins over the same name in .env.
model Setting {
  name      String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Monthly model-spend limit. warnedMonth/stoppedMonth hold "YYYY-MM" so each
// threshold notifies once per calendar month (UTC), not on every run.
model Budget {
  userId          String   @id
  monthlyLimitUsd Decimal  @default(10)
  alertEmail      String?
  warnedMonth     String?
  stoppedMonth    String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Run {
  id         String   @id @default(uuid())
  userId     String?
  status     RunStatusEnum
  createdAt  DateTime @default(now())
  leaseUntil DateTime?
  leaseGen   Int      @default(0)
  attempts   Int      @default(0)
  cancelRequested Boolean @default(false)
  costUsd    Decimal?   @default(0)
  /// Ran on the user's Claude or ChatGPT plan: no per-run cost, not counted toward the spend limit.
  onPlan     Boolean    @default(false)
  repo       String
  baseBranch String
  branch     String?
  prompt     String
  harness    String
  workerId   String?
  sessionId  String?
  baseSha    String?
  commitSha  String?
  patchHash  String?
  prUrl      String?
  error      String?
  threadId   String?
  /// From the turn's patch, for comparing agents.
  filesChanged Int?
  additions  Int?
  deletions  Int?
  /// The turn's virtual display (VNC) password, when the session has a desktop.
  desktopPassword String?
  /// Set on a council member's or chair's turn (see Council).
  councilId    String?
  /// 1..rounds for members; rounds + 1 is the chair's report.
  councilRound Int?
  /// member | chair
  councilRole  String?
  /// What a council turn wrote as its answer.
  output       String?
  /// A turn another session's agent asked for (send_to_session): the session and turn it came from.
  fromThreadId String?
  fromRunId    String?
  /// How many messages deep this turn is in a chain between sessions; capped so agents can't loop.
  hops         Int      @default(0)
  /// When it finishes, its reply goes back to this session as a new turn.
  replyToThreadId String?
  /// turn | fix (Cloudly asked the agent to fix the checks its last change broke)
  kind         String   @default("turn")
  /// The repo's checks after the turn's changes: passed | failed | error (couldn't run) | skipped.
  checkStatus  String?
  checkCommand String?
  /// The end of the checks' output.
  checkOutput  String?
  checkMs      Int?
  /// Its last change; once it has ended, when it ended. Unread sessions compare against it.
  updatedAt  DateTime @default(now()) @updatedAt
  events     RunEvent[]
  user       User?    @relation(fields: [userId],references: [id],onDelete: Cascade)
  thread     Thread?  @relation(fields: [threadId],references: [id],onDelete: Cascade)
  council    Council? @relation(fields: [councilId],references: [id],onDelete: Cascade)
  @@unique([councilId, councilRound, councilRole, harness])
  /// One message per turn to each session, so a retried turn can't send it twice.
  @@unique([fromRunId, threadId])
  @@index([status,createdAt])
  @@index([userId])
  @@index([threadId, createdAt])
}

model RunEvent {
  runId     String  
  seq       Int
  ts        DateTime @default(now())
  kind      RunEventEnum
  data      Json?
  run       Run   @relation(fields:[runId], references: [id],onDelete: Cascade)
  @@id([runId, seq])
  
}

enum RunStatusEnum{
  queued
  running
  finalizing
  succeeded
  failed
  cancelled
}

enum RunEventEnum{
  status
  text
  tool_call
  tool_result
  raw
  error
  done
}
/// The sandbox image built from the user's setup script (one row, id 1).
model SandboxImage {
  id         Int      @id @default(1)
  /// Hash of the base image and script the latest build was for.
  scriptHash String   @default("")
  /// pending | building | ready | failed
  status     String   @default("ready")
  log        String   @default("")
  /// The last image that built successfully; runs use it.
  image      String   @default("cloud-agents-base")
  updatedAt  DateTime @updatedAt
}

/// Shared context for a repo, opt-in: notes every agent reads, plus a log of
/// what each session and connected editor did, so Claude, Codex, Gemini and
/// local tools (Cursor, Claude Code, through the context MCP endpoint) work from
/// the same picture of the repo.
model RepoContext {
  repo      String   @id
  enabled   Boolean  @default(true)
  /// Conventions and decisions, in Markdown. Editable by the user and agents.
  notes     String   @default("")
  updatedAt DateTime @updatedAt
}

model ContextEntry {
  id        String   @id @default(uuid())
  repo      String
  /// turn | note | decision
  kind      String
  /// The agent (its harness id) or the connected tool's name, e.g. "Cursor on my laptop".
  author    String
  /// cloudly | mcp
  source    String
  title     String
  body      String   @default("")
  threadId  String?
  runId     String?
  prUrl     String?
  createdAt DateTime @default(now())
  @@index([repo, createdAt])
}

/// A personal token for tools outside Cloudly (Cursor, Claude Code) to reach
/// the context MCP endpoint. Only its SHA-256 is stored.
model AccessToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

/// Several agents on one question, in rounds: they research independently,
/// review each other's findings, state final positions, and a chair writes the
/// report. Each agent's turn in a round is a Run. With no repo it's a research
/// council: open web, no repo, no secrets.
model Council {
  id         String   @id @default(uuid())
  userId     String
  question   String
  repo       String?
  baseBranch String?
  /// Harness ids, in the order shown.
  members    String[]
  chair      String
  rounds     Int      @default(3)
  /// The round under way; rounds + 1 is the chair's report.
  round      Int      @default(1)
  /// running | done | stopped | failed | cancelled
  status     String   @default("running")
  /// Spending cap for the whole council; null is no cap beyond the monthly limit.
  budgetUsd  Decimal?
  /// Notes the user added between rounds: [{ text, round, at }].
  guidance   Json     @default("[]")
  report     String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs       Run[]
  @@index([userId, createdAt])
}

/// How Cloudly treats a repo's turns. One row per repo; no row means the defaults.
model RepoSettings {
  repo            String   @id
  /// auto (detected from the repo) | custom | off
  checks          String   @default("auto")
  checkCommand    String?
  /// Fix turns Cloudly may start in a row when checks fail; 0 turns that off.
  fixAttempts     Int      @default(2)
  checkTimeoutSec Int      @default(600)
  updatedAt       DateTime @updatedAt
}
