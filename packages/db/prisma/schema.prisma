// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  githubId    Int      @unique
  login       String
  avatarUrl   String?
  /// The Discord account linked to this user (with /cloudly link): only linked accounts can use the bot.
  discordUserId String? @unique
  /// The Slack account linked to this user (with /cloudly link).
  slackUserId   String? @unique
  createdAt   DateTime   @default(now())
  sessions    Session[]
  runs        Run[]
  threads     Thread[]
  schedules   Schedule[]
  plans       Plan[]
  sentryProjects SentryProject[]
  notifications Notification[]
  notifySettings NotifySettings?
  arenas      Arena[]
  previews    Preview[]
  tokens      AccessToken[]
  councils    Council[]
  budget      Budget?
}

// A conversation with one agent about one repo. Each message is a Run (a
// turn). Turns share a git branch and one pull request, and resume the
// agent's own session through agentSessionId.
model Thread {
  id             String   @id @default(uuid())
  userId         String
  repo           String
  baseBranch     String
  harness        String
  title          String
  branch         String
  agentSessionId String?
  /// Chosen with "/model <name>" in the chat; passed to every later turn, so it
  /// beats a model pinned in the repo's own agent settings.
  model          String?
  /// How hard the agent thinks (see @repo/shared/effort); null is its default.
  effort         String?
  prUrl          String?
  /// Set when the session is one of an arena's agents (see Arena).
  arenaId        String?
  /// Open a pull request when a turn changes code. Arena sessions wait until
  /// their result is picked.
  autoPr         Boolean  @default(true)
  /// Turns get a virtual display the agent can use and the user can watch.
  desktop        Boolean  @default(false)
  /// Which other sessions its agent may read and message (see @repo/shared/sessions):
  /// "repo" (this repo's), "all" (every one of the user's), or "off".
  peers          String   @default("repo")
  /// Sidebar state, like T3 Code's threads. Pinned sessions sit at the top.
  pinnedAt       DateTime?
  /// Done for now: folded into the sidebar's Settled section until there's new activity.
  settledAt      DateTime?
  /// Hidden from the sidebar until this time, then back as unread.
  snoozedUntil   DateTime?
  /// Out of the sidebar and out of other sessions' reach, until unarchived.
  archivedAt     DateTime?
  /// When the user last looked at it; a turn that ended after this is unread. Null is never.
  seenAt         DateTime?
  /// The question the agent asked with ask_user, until the user answers.
  needsInput     String?
  /// Everything the session has changed so far, base branch to its branch, after its last commit.
  diff           String?
  /// The commit that diff starts from.
  diffBase       String?
  /// The GitHub issue the session was started from (a label or an @cloudly mention).
  issueNumber    Int?
  /// Merge the pull request once it's ready: checks, review and CI green, nothing in the way.
  autoMerge      Boolean  @default(false)
  /// What merge-when-ready is waiting for, or what happened, for the session's header.
  mergeStatus    String?
  mergedAt       DateTime?
  /// Its pull request was closed without merging (for the agent scorecard).
  prClosedAt     DateTime?
  /// When Cloudly last asked GitHub how its pull request ended up.
  prCheckedAt    DateTime?
  /// The schedule that started the session, if one did.
  scheduleId     String?
  /// Started from Discord: the channel, and the Discord thread its updates go to.
  discordChannelId String?
  discordThreadId  String?
  /// The interaction's token, kept only until the Discord thread is made (it expires after 15 minutes).
  discordToken     String?
  /// Started from Slack: the channel, and the ts of the message its updates are threaded under
  /// ("-" when that message couldn't be posted).
  slackChannelId   String?
  slackThreadTs    String?
  /// An added agent's session total in USD after the last turn (OpenCode reports totals), so a resumed turn's cost is the difference.
  agentSessionCost Float?
  /// A fork: the session it came from, and the turn it was forked after.
  forkOfThreadId   String?
  forkAtRunId      String?
  /// One task of a plan (see Plan).
  planId           String?
  /// Brought in from an agent run elsewhere (see SessionImport).
  imported         SessionImport?
  artifacts        Artifact[]
  handoffs         SessionHandoff[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  arena          Arena?   @relation(fields: [arenaId], references: [id], onDelete: SetNull)
  runs           Run[]
  previews       Preview[]
  findings       ReviewFinding[]
  @@index([userId, updatedAt])
  @@index([repo, issueNumber])
  @@index([repo, branch])
  @@index([arenaId])
}

/// One task handed to several agents at once, each in its own session and
/// branch, so their results can be compared before one becomes the PR.
model Arena {
  id             String   @id @default(uuid())
  userId         String
  repo           String
  baseBranch     String
  prompt         String
  /// The session whose branch was opened as the pull request.
  winnerThreadId String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads        Thread[]
  @@index([userId, createdAt])
}

/// A remote MCP server the agents may use. Its credentials (OAuth tokens and
/// client, or a bearer token) are AES-256-GCM ciphertext in `secret`, and only
/// ever reach the credential gateway, never a sandbox.
model McpServer {
  id        String   @id @default(uuid())
  /// What agents see it as: lowercase letters, digits and dashes.
  name      String   @unique
  url       String
  /// oauth | bearer | none
  auth      String   @default("oauth")
  enabled   Boolean  @default(true)
  /// connected | needs_auth | error
  status    String   @default("needs_auth")
  error     String?
  secret    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An agent added under Settings > Agents, beyond the three built in: from
/// Cloudly's catalog, the ACP registry, or a command the user entered (see
/// @repo/shared/providers). The sandbox image installs it and turns run it over
/// the Agent Client Protocol. Its keys reach the sandbox only as placeholders.
model Provider {
  /// Its harness id: "acp-" and a slug.
  id        String   @id
  name      String
  /// catalog | registry | custom
  source    String
  /// The catalog or registry id it came from.
  sourceId  String?
  /// The registry version it was added at.
  version   String?
  icon      String?
  /// How the image installs it, how the runner starts it, its keys and hosts (ProviderSpec).
  spec      Json
  /// AES-256-GCM ciphertext of { ENV_NAME: value }.
  secret    String?
  enabled   Boolean  @default(true)
  /// Install newer versions on its own (catalog and registry agents; never one added by command).
  autoUpdate Boolean @default(true)
  /// Before switching to an update, try it on past tasks against the current version (see AgentTrial).
  testUpdates Boolean @default(false)
  /// A newer version found and not installed yet (auto-update off), with its launch.
  availableVersion String?
  availableLaunch  Json?
  /// While an update builds: the launch and version to go back to if it doesn't install.
  previousLaunch   Json?
  previousVersion  String?
  /// updating | updated | failed, with what happened, for its row in Settings.
  updateState  String?
  updateNote   String?
  updatedVersionAt DateTime?
  /// A version that failed to install, so it isn't tried again.
  skipVersion  String?
  checkedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An environment variable for runs. The sandbox gets a placeholder, and the
/// gateway swaps in the real value only on HTTPS requests to `hosts`, unless
/// `exposed` puts the real value in the sandbox.
model EnvSecret {
  id        String   @id @default(uuid())
  name      String
  /// "owner/repo", or "*" for every repo.
  repo      String   @default("*")
  /// Ciphertext.
  value     String
  /// Newline-separated; subdomains are included.
  hosts     String   @default("")
  exposed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([repo, name])
}

/// A repo's files outside git, mounted at /files in every run. Whatever the
/// agent leaves there is saved back for the next run.
model RepoFile {
  repo      String
  path      String
  content   Bytes
  size      Int
  sha256    String
  updatedAt DateTime @updatedAt
  @@id([repo, path])
}

/// A session's app, started from its branch and kept running so the user can
/// open it, or watch it on the sandbox's desktop.
model Preview {
  id          String   @id @default(uuid())
  threadId    String
  userId      String
  /// requested | starting | running | stopping | stopped | failed
  status      String   @default("requested")
  command     String
  port        Int
  desktop     Boolean  @default(false)
  workerId    String?
  error       String?
  log         String   @default("")
  vncPassword String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([threadId, createdAt])
}

// Instance configuration entered in the browser (model keys, the GitHub App's
// credentials, the sign-in allowlist). `value` is AES-256-GCM ciphertext; a
// value here wins over the same name in .env.
model Setting {
  name      String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Monthly model-spend limit. warnedMonth/stoppedMonth hold "YYYY-MM" so each
// threshold notifies once per calendar month (UTC), not on every run.
model Budget {
  userId          String   @id
  monthlyLimitUsd Decimal  @default(10)
  alertEmail      String?
  warnedMonth     String?
  stoppedMonth    String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Run {
  id         String   @id @default(uuid())
  userId     String?
  status     RunStatusEnum
  createdAt  DateTime @default(now())
  leaseUntil DateTime?
  leaseGen   Int      @default(0)
  attempts   Int      @default(0)
  cancelRequested Boolean @default(false)
  costUsd    Decimal?   @default(0)
  /// Ran on the user's Claude or ChatGPT plan: no per-run cost, not counted toward the spend limit.
  onPlan     Boolean    @default(false)
  repo       String
  baseBranch String
  branch     String?
  prompt     String
  harness    String
  workerId   String?
  sessionId  String?
  baseSha    String?
  commitSha  String?
  patchHash  String?
  prUrl      String?
  error      String?
  threadId   String?
  /// From the turn's patch, for comparing agents.
  filesChanged Int?
  additions  Int?
  deletions  Int?
  /// The turn's virtual display (VNC) password, when the session has a desktop.
  desktopPassword String?
  /// Set on a council member's or chair's turn (see Council).
  councilId    String?
  /// 1..rounds for members; rounds + 1 is the chair's report.
  councilRound Int?
  /// member | chair
  councilRole  String?
  /// What a council turn wrote as its answer.
  output       String?
  /// A turn another session's agent asked for (send_to_session): the session and turn it came from.
  fromThreadId String?
  fromRunId    String?
  /// How many messages deep this turn is in a chain between sessions; capped so agents can't loop.
  hops         Int      @default(0)
  /// When it finishes, its reply goes back to this session as a new turn.
  replyToThreadId String?
  /// turn | fix (Cloudly asked the agent to fix the checks its last change broke)
  kind         String   @default("turn")
  /// What on GitHub started the turn: {type: issue|mention|pr_review|ci, by, url, number}.
  trigger      Json?
  /// One turn per GitHub event, so a redelivered webhook can't start a second.
  triggerKey   String?  @unique
  /// Undone by a rewind: left out of the agent's history, and shown as rewound.
  rewoundAt    DateTime?
  /// A rewind or fork turn: the turn whose checkpoint it goes back to.
  targetRunId  String?
  /// A planner's turn (kind "plan"): the plan it writes.
  planId       String?
  /// The repo's checks after the turn's changes: passed | failed | error (couldn't run) | skipped.
  checkStatus  String?
  checkCommand String?
  /// The end of the checks' output.
  checkOutput  String?
  checkMs      Int?
  /// Its last change; once it has ended, when it ended. Unread sessions compare against it.
  updatedAt  DateTime @default(now()) @updatedAt
  events     RunEvent[]
  findings   ReviewFinding[]
  user       User?    @relation(fields: [userId],references: [id],onDelete: Cascade)
  thread     Thread?  @relation(fields: [threadId],references: [id],onDelete: Cascade)
  council    Council? @relation(fields: [councilId],references: [id],onDelete: Cascade)
  @@unique([councilId, councilRound, councilRole, harness])
  /// One message per turn to each session, so a retried turn can't send it twice.
  @@unique([fromRunId, threadId])
  @@index([status,createdAt])
  @@index([userId])
  @@index([threadId, createdAt])
  steers       RunSteer[]
}

model RunEvent {
  runId     String  
  seq       Int
  ts        DateTime @default(now())
  kind      RunEventEnum
  data      Json?
  run       Run   @relation(fields:[runId], references: [id],onDelete: Cascade)
  @@id([runId, seq])
  
}

enum RunStatusEnum{
  queued
  running
  finalizing
  succeeded
  failed
  cancelled
}

enum RunEventEnum{
  status
  text
  tool_call
  tool_result
  raw
  error
  done
}
/// The sandbox image built from the user's setup script (one row, id 1).
model SandboxImage {
  id         Int      @id @default(1)
  /// Hash of the base image and script the latest build was for.
  scriptHash String   @default("")
  /// pending | building | ready | failed
  status     String   @default("ready")
  log        String   @default("")
  /// The last image that built successfully; runs use it.
  image      String   @default("cloud-agents-base")
  updatedAt  DateTime @updatedAt
}

/// Shared context for a repo, opt-in: notes every agent reads, plus a log of
/// what each session and connected editor did, so Claude, Codex, Gemini and
/// local tools (Cursor, Claude Code, through the context MCP endpoint) work from
/// the same picture of the repo.
model RepoContext {
  repo      String   @id
  enabled   Boolean  @default(true)
  /// Conventions and decisions, in Markdown. Editable by the user and agents.
  notes     String   @default("")
  updatedAt DateTime @updatedAt
}

model ContextEntry {
  id        String   @id @default(uuid())
  repo      String
  /// turn | note | decision
  kind      String
  /// The agent (its harness id) or the connected tool's name, e.g. "Cursor on my laptop".
  author    String
  /// cloudly | mcp
  source    String
  title     String
  body      String   @default("")
  threadId  String?
  runId     String?
  prUrl     String?
  createdAt DateTime @default(now())
  @@index([repo, createdAt])
}

/// A personal token for tools outside Cloudly (Cursor, Claude Code) to reach
/// the context MCP endpoint. Only its SHA-256 is stored.
model AccessToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

/// Several agents on one question, in rounds: they research independently,
/// review each other's findings, state final positions, and a chair writes the
/// report. Each agent's turn in a round is a Run. With no repo it's a research
/// council: open web, no repo, no secrets.
model Council {
  id         String   @id @default(uuid())
  userId     String
  question   String
  repo       String?
  baseBranch String?
  /// Harness ids, in the order shown.
  members    String[]
  chair      String
  rounds     Int      @default(3)
  /// The round under way; rounds + 1 is the chair's report.
  round      Int      @default(1)
  /// running | done | stopped | failed | cancelled
  status     String   @default("running")
  /// Spending cap for the whole council; null is no cap beyond the monthly limit.
  budgetUsd  Decimal?
  /// Notes the user added between rounds: [{ text, round, at }].
  guidance   Json     @default("[]")
  report     String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs       Run[]
  @@index([userId, createdAt])
}

/// How Cloudly treats a repo's turns. One row per repo; no row means the defaults.
model RepoSettings {
  repo            String   @id
  /// auto (detected from the repo) | custom | off
  checks          String   @default("auto")
  checkCommand    String?
  /// Fix turns Cloudly may start in a row when checks fail; 0 turns that off.
  fixAttempts     Int      @default(2)
  checkTimeoutSec Int      @default(600)
  /// The agent that reviews each change (a harness id), or null for no reviewer.
  reviewer        String?
  /// Turns the author gets to fix blocking findings before the session asks the user.
  reviewRounds    Int      @default(2)
  /// Post the reviewer's findings to the pull request as a review.
  reviewPostToGitHub Boolean @default(true)
  /// GitHub triggers. The agent new sessions from GitHub use; null is Claude Code.
  triggerHarness  String?
  /// Labelling an issue with this starts a session for it.
  issueLabel      String   @default("cloudly")
  onIssueLabel    Boolean  @default(true)
  /// "@cloudly ..." in an issue or pull request comment.
  onMention       Boolean  @default(true)
  /// A review on a pull request Cloudly opened becomes the session's next turn.
  onPrReview      Boolean  @default(true)
  /// Failing CI on a pull request Cloudly opened: the agent gets turns to fix it.
  fixCi           Boolean  @default(true)
  ciFixAttempts   Int      @default(2)
  /// New sessions on this repo start with merge-when-ready on.
  autoMerge       Boolean  @default(false)
  /// squash | merge | rebase
  mergeMethod     String   @default("squash")
  /// After a turn that changes UI files: start the app before and after the
  /// change, screenshot these pages, and show them side by side (needs the
  /// sandbox's desktop tools, for Chromium).
  screenshots       Boolean  @default(false)
  screenshotCommand String?
  screenshotPort    Int      @default(3000)
  screenshotPaths   String[] @default(["/"])
  /// Look for lessons in the repo's sessions every week (an agent turn each time).
  autoLessons       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

/// What a reviewer (or an audit) found. Blocking findings go back to the author
/// automatically; the rest wait for the user to send or dismiss them.
model ReviewFinding {
  id        String   @id @default(uuid())
  /// The review or audit turn that found it.
  runId     String
  threadId  String
  /// Repo-relative path and line on the changed side, when it points at one.
  file      String?
  line      Int?
  /// blocking | suggestion | nit
  severity  String
  title     String
  body      String
  /// open | sent (to the agent) | dismissed
  status    String   @default("open")
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  @@index([threadId, createdAt])
  @@index([runId])
}

/// A GitHub webhook delivery, stored by the API once its signature checks out and
/// handled by the worker (see apps/worker/src/webhooks.ts).
model WebhookDelivery {
  /// GitHub's X-GitHub-Delivery id: a redelivery is the same row.
  id         String   @id
  event      String
  action     String?
  payload    Json
  /// pending | processing | done | ignored | failed
  status     String   @default("pending")
  attempts   Int      @default(0)
  /// What the worker did with it, or why not.
  note       String?
  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([status, receivedAt])
}

/// A task that runs on its own at set times: a new session each time, or the
/// next turn of the same one.
model Schedule {
  id         String    @id @default(uuid())
  userId     String
  name       String
  repo       String
  baseBranch String
  harness    String
  prompt     String
  /// turn | audit
  kind       String    @default("turn")
  /// hourly | daily | weekdays | weekly
  frequency  String
  /// Minutes after midnight (or, for hourly, after the hour), in timeZone.
  minuteOfDay Int
  /// 0 = Sunday, for weekly.
  weekday    Int?
  timeZone   String
  /// new: a session each time. continue: the next turn of one session.
  mode       String    @default("new")
  threadId   String?
  enabled    Boolean   @default(true)
  nextRunAt  DateTime
  lastRunAt  DateTime?
  /// What the last firing did, or why it didn't start anything.
  lastNote   String?
  lastThreadId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([enabled, nextRunAt])
  @@index([userId])
}

/// A one-time code from Settings > Discord, entered with /cloudly link.
model DiscordLinkCode {
  code      String   @id
  userId    String
  /// discord | slack
  provider  String   @default("discord")
  expiresAt DateTime
}

/// A Discord channel's default repo for /cloudly task.
model DiscordChannel {
  channelId String   @id
  repo      String
  baseBranch String?
  updatedAt DateTime @updatedAt
}

/// Where and when a user hears from Cloudly. The webhook URLs hold tokens, so
/// they're stored encrypted with the instance's key.
model NotifySettings {
  userId            String  @id
  discordDm         Boolean @default(true)
  slackDm           Boolean @default(true)
  discordWebhookUrl String?
  slackWebhookUrl   String?
  onNeedsYou        Boolean @default(true)
  onDone            Boolean @default(true)
  onFailed          Boolean @default(true)
  onMerged          Boolean @default(true)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Something to tell a user about, sent by the worker's notifier.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  threadId  String?
  /// needs_you | done | failed | merged
  kind      String
  title     String
  body      String
  url       String?
  /// One per event, so it can't be sent twice.
  key       String    @unique
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  attempts  Int       @default(0)
  error     String?
  /// Where it has gone so far (discord-thread, discord-dm, discord-webhook, slack), so a retry only sends the rest.
  sentTo    String[]  @default([])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([sentAt, createdAt])
}

/// A Slack channel's default repo for /cloudly.
model SlackChannel {
  channelId  String   @id
  repo       String
  baseBranch String?
  updatedAt  DateTime @updatedAt
}

/// A big task broken into smaller ones: a planner agent writes the tasks and
/// the order between them; once started, each task becomes its own session and
/// pull request, as soon as the tasks it waits for are merged.
model Plan {
  id          String     @id @default(uuid())
  userId      String
  repo        String
  baseBranch  String
  goal        String
  /// The agent that plans, and the one each task's session uses.
  planner     String
  harness     String
  /// planning | ready | running | done | failed | cancelled
  status      String     @default("planning")
  /// Tasks whose sessions may work at the same time.
  maxParallel Int        @default(3)
  /// Each task's session merges its pull request when it's ready, so the tasks after it build on it.
  autoMerge   Boolean    @default(true)
  /// The planner's overview, or why planning failed.
  summary     String?
  error       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       PlanTask[]
  @@index([status])
  @@index([userId, createdAt])
}

model PlanTask {
  id        String   @id @default(uuid())
  planId    String
  /// A short name the others refer to in dependsOn.
  key       String
  title     String
  prompt    String
  dependsOn String[] @default([])
  position  Int
  /// The task's session, once started.
  threadId  String?  @unique
  /// pending | running | review (PR open, not merged) | needs_you | done | failed | skipped
  status    String   @default("pending")
  note      String?
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, key])
}

/// A session brought into Cloudly from a coding agent run elsewhere (Claude Code,
/// Codex, Pi, Gemini CLI, OpenCode, or any chat export; see @repo/shared/session-import).
/// Its conversation becomes the session's first turns (Run.kind "import_turn");
/// a queued "import" turn sets up its branch and, when the session's agent wrote
/// the file, the agent's own session to resume.
model SessionImport {
  id        String   @id @default(uuid())
  threadId  String   @unique
  /// claude-code | codex | pi | gemini | opencode | chat | text
  source    String
  /// The agent's own id for the session, and the directory it ran in.
  sessionId String?
  cwd       String?
  /// The original file, gzipped and sealed, for the agent that wrote it to resume.
  fileName  String?
  file      String?
  /// The agent's own summary from before a compaction.
  summary   String?
  /// The branch the session's code starts from, if not the base branch.
  startFrom String?
  turns     Int
  /// Older turns left out (only the most recent are kept).
  dropped   Int      @default(0)
  /// Whether the session's agent picked up its own session (set by the import turn).
  resumed   Boolean  @default(false)
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

/// Something an agent made for the user to look at (see @repo/shared/artifacts):
/// a file it wrote to /artifacts. One row per version; a session's artifacts are
/// keyed by name.
model Artifact {
  id         String   @id @default(uuid())
  threadId   String
  /// The turn that wrote this version.
  runId      String
  name       String
  /// html | svg | image | markdown | mermaid | csv | pdf | text
  kind       String
  mime       String
  content    Bytes
  size       Int
  sha256     String
  version    Int
  /// Anyone with the link can view it (see the API's shared routes).
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  @@unique([threadId, name, version])
  @@index([runId])
}

/// A session going back to the user's computer (the import command's "pull"):
/// the worker reads the agent's own session file from the session's home and
/// writes the conversation out, for the command to pick up. Kept a day.
model SessionHandoff {
  id         String   @id @default(uuid())
  threadId   String
  userId     String
  /// pending | working | ready | failed
  status     String   @default("pending")
  error      String?
  harness    String
  /// The agent's own session: its id, file name, and the file (gzipped, sealed), paths as in the sandbox.
  sessionId  String?
  fileName   String?
  file       String?
  /// The conversation as a prompt, for an agent that can't open the file.
  transcript String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

/// A Sentry project whose new errors start fix sessions on a repo (see the
/// worker's sentry.ts). Sessions belong to the user who connected it.
model SentryProject {
  id        String   @id @default(uuid())
  /// The project's slug in Sentry.
  slug      String   @unique
  repo      String
  userId    String
  /// The agent that fixes; null is the repo's GitHub-trigger agent.
  harness   String?
  enabled   Boolean  @default(true)
  /// Sessions it may start a day, so an outage doesn't start fifty.
  perDay    Int      @default(5)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A message the user sent while a turn was running, for that turn's agent to
/// take in as it works (see the worker's process-run and the runner). One the
/// turn ends before taking becomes the session's next turn instead.
model RunSteer {
  id        String   @id @default(uuid())
  runId     String
  text      String
  /// pending | sent (written for the runner) | delivered (the agent has it) | late (became a turn)
  status    String   @default("pending")
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId, status])
}

/// A rule for a repo's notes, proposed from what went wrong in its sessions
/// (see the worker's lessons.ts); accepted ones go into its shared-context notes.
model Lesson {
  id        String    @id @default(uuid())
  repo      String
  /// The lessons turn that proposed it.
  runId     String
  title     String
  rule      String
  why       String    @default("")
  /// What it's based on: [{ "ref": "F3", "text": "...", "threadId": "..." }].
  evidence  Json
  /// proposed | accepted | dismissed
  status    String    @default("proposed")
  decidedAt DateTime?
  createdAt DateTime  @default(now())
  @@index([repo, status])
}

/// An added agent's update, tried before it's installed: a few of its merged
/// sessions replayed on the current version and on the new one, compared on
/// checks, cost, and how close each came to what was merged (see the worker's trials.ts).
model AgentTrial {
  id          String   @id @default(uuid())
  providerId  String
  fromVersion String?
  toVersion   String
  /// The new version's launch, to install if it holds up.
  launch      Json
  /// pending | running | passed | failed | installed | cancelled
  status      String   @default("pending")
  /// Per task, both versions' results, and the verdict.
  results     Json?
  verdict     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([providerId, createdAt])
  @@index([status])
}
