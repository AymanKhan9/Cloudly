# Cloudly configuration. install.sh writes this file for you as /opt/cloudly/.env;
# every service reads the same file. Keep it chmod 600: it holds your keys.

# Where people reach this instance. Use https://your.domain when DOMAIN is set,
# otherwise http://<server-ip>:3000.
PUBLIC_URL=http://203.0.113.10:3000
WEB_ORIGIN=http://203.0.113.10:3000
API_ORIGIN=http://203.0.113.10:3000/api
# Optional: a domain pointing at this VM turns on automatic HTTPS via Caddy.
DOMAIN=

# Database (Postgres runs in Docker, bound to localhost only).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://cloudly:change-me@127.0.0.1:5432/cloudly
API_PORT=8787

# One-time token that protects first-run setup at <PUBLIC_URL>/setup, and the key
# that encrypts everything you save in the browser. install.sh generates both.
CLOUDLY_SETUP_TOKEN=
CLOUDLY_SECRET_KEY=

# Everything below is optional here: the GitHub App, the sign-in list and the model
# keys are normally entered in the browser (setup page, then Settings) and stored
# encrypted. A value set here is only a fallback for one saved in the browser.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/opt/cloudly/github-app.pem
# ALLOWED_GITHUB_LOGINS=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# RESEND_API_KEY=

# Gemini model. Defaults to gemini-3-flash-preview; "auto" lets Gemini choose,
# which on a free-tier key tends to pick models with no quota and stall.
# GEMINI_MODEL=gemini-3-flash-preview
# Agents whose own saved sessions carry a conversation across turns (untested):
# CLOUDLY_NATIVE_RESUME=native-claude,native-codex

# Budget alert email (optional). Without it, alerts are in-app only.
ALERT_FROM=Cloudly <onboarding@resend.dev>

# Runs in parallel. Keep 1 on a 1 GB VM.
WORKER_CONCURRENCY=1

# Prices (USD per million tokens) used to estimate Codex and Gemini cost.
# Claude Code reports exact cost and ignores these.
# PRICE_CODEX_INPUT_PER_MTOK=1.25
# PRICE_CODEX_OUTPUT_PER_MTOK=10
# PRICE_GEMINI_INPUT_PER_MTOK=0.30
# PRICE_GEMINI_OUTPUT_PER_MTOK=2.50
